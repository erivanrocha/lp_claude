{
  "name": "nvo-endereco-fiscal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "dev:worker": "wrangler dev --config wrangler.worker.toml",
    "deploy:worker": "wrangler deploy --config wrangler.worker.toml",
    "db:migrate": "wrangler d1 migrations apply nvo-endereco-fiscal --remote",
    "db:migrate:local": "wrangler d1 migrations apply nvo-endereco-fiscal --local"
  },
  "devDependencies": {
    "wrangler": "^4.143.0"
  }
}
